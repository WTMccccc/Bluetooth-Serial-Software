#pragma code_page(65001)
#include <windows.h>

#define IDI_APPICON 101

IDI_APPICON ICON "app.ico"

/* 应用程序清单：通用控件 v6 + Per-Monitor V2 DPI */
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "BLE UART Host"
            VALUE "FileDescription", "BLE 串口助手"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "ble_uart"
            VALUE "OriginalFilename", "ble_uart.exe"
            VALUE "ProductName", "BLE 串口助手"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
